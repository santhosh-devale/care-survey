# Copy this file to ".env" (same folder) and fill in the two values from your Supabase project.
# Supabase > Project Settings > API Keys (the Connect button at the top also shows both).
#
# Use the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon" key.
# NEVER put the "secret" or "service_role" key here: it would be visible to everyone who opens the app.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_KEY=sb_publishable_your_key_here
