# Copy this file to ".env" for local development.
# The public project URL is configured in src/supabase.ts.
#
# Use the PUBLISHABLE key (starts with sb_publishable_) or the legacy "anon" key.
# Never use the Supabase secret or service_role key in a browser app.

VITE_SUPABASE_KEY=sb_publishable_your_key_here
